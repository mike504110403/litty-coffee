# prod 環境變數範本。複製到主機 /opt/litty/prod/.env（擁有者 deploy、chmod 600），真值絕不進 git。
# 空白＝必填或可選的機密；<...>＝請換成實際值。產生隨機值：openssl rand -hex 32
# dev 與 prod 的 POSTGRES_PASSWORD／JWT_SECRET／SECRET_KEY 一律各自產生，不共用。

# ---- compose 本身 ----
COMPOSE_PROJECT_NAME=litty-prod
COMPOSE_FILE=compose.yml:compose.prod.yml
LITTY_ENV=prod
# 映像 tag：平常用移動 tag prod；手動回滾時可暫時改成某個 commit sha
IMAGE_TAG=prod

# ---- Cloudflare Tunnel（token 模式；Public Hostname admin.litty-coffee.com → http://web:80）----
CLOUDFLARE_TUNNEL_TOKEN=
# 空＝latest；建議釘版本，例 2026.10.7
CLOUDFLARED_VERSION=

# ---- 資料庫 ----
# 只用英數（openssl rand -hex 24），會直接組進 DATABASE_URL
POSTGRES_PASSWORD=

# ---- 後端（見 backend/.env.example、internal/config）----
# 至少 16 字
JWT_SECRET=
# 加密 DB 內憑證與 IG token 的金鑰；正式環境必設、設定後不要再換（換了已存憑證解不開、IG 要重新連結）
SECRET_KEY=
ADMIN_USER=admin
# 只在 DB 沒有任何管理員時用來建第一個店長（≥8 字）；建好後可清空
ADMIN_PASSWORD=
# https 開頭 → 登入 cookie 帶 Secure；也是 OAuth redirect URI 的前綴
WEB_ORIGIN=https://admin.litty-coffee.com
# IG 從這裡抓貼文媒體（/media/...），必須公開 HTTPS
PUBLIC_BASE_URL=https://admin.litty-coffee.com
DEV_SIMULATOR=0
TZ_STORE=Asia/Taipei

# IG／AI：兜底值，後台「憑證」頁填過的優先
IG_APP_ID=
IG_APP_SECRET=
IG_CONFIG_ID=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
# 空＝程式預設 https://graph.facebook.com/v27.0
IG_API_BASE=
ANTHROPIC_API_KEY=
# 空＝程式預設
AI_MODEL=
AI_EFFORT=

# ---- 記憶體上限（4GB 主機同跑 dev＋prod；空＝compose 預設）----
PG_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=64mb
BACKEND_MEM_LIMIT=512m
BACKEND_GOMEMLIMIT=420MiB
WEB_MEM_LIMIT=128m
CLOUDFLARED_MEM_LIMIT=128m
