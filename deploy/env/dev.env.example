# dev 環境變數範本。複製到主機 /opt/litty/dev/.env（擁有者 deploy、chmod 600），真值絕不進 git。
# 空白＝必填或可選的機密；<...>＝請換成實際值。產生隨機值：openssl rand -hex 32

# ---- compose 本身 ----
COMPOSE_PROJECT_NAME=litty-dev
COMPOSE_FILE=compose.yml:compose.dev.yml
LITTY_ENV=dev
# 映像 tag：平常用移動 tag dev；手動回滾時可暫時改成某個 commit sha
IMAGE_TAG=dev
# web 綁定的主機位址＝主機 Tailscale IP（tailscale ip -4），只有 tailnet 連得到
WEB_BIND=<tailscale-ip>
WEB_PORT=8080

# ---- 資料庫 ----
# 只用英數（openssl rand -hex 24），會直接組進 DATABASE_URL
POSTGRES_PASSWORD=

# ---- 後端（見 backend/.env.example、internal/config）----
# 至少 16 字
JWT_SECRET=
# 加密 DB 內憑證與 IG token 的金鑰；設定後不要再換
SECRET_KEY=
ADMIN_USER=admin
# 只在 DB 沒有任何管理員時用來建第一個店長（≥8 字）；建好後可清空
ADMIN_PASSWORD=
WEB_ORIGIN=http://<tailscale-ip>:8080
PUBLIC_BASE_URL=http://<tailscale-ip>:8080
DEV_SIMULATOR=1
TZ_STORE=Asia/Taipei

# IG／AI：兜底值，後台「憑證」頁填過的優先；dev 開模擬器時可全空
IG_APP_ID=
IG_APP_SECRET=
IG_CONFIG_ID=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
# 空＝程式預設 https://graph.facebook.com/v27.0
IG_API_BASE=
ANTHROPIC_API_KEY=
# 空＝程式預設
AI_MODEL=
AI_EFFORT=

# ---- 記憶體上限（4GB 主機同跑 dev＋prod；空＝compose 預設）----
PG_MEM_LIMIT=256m
REDIS_MEM_LIMIT=96m
REDIS_MAXMEMORY=48mb
BACKEND_MEM_LIMIT=384m
BACKEND_GOMEMLIMIT=300MiB
WEB_MEM_LIMIT=128m
