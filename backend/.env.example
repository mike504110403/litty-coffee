ADDR=:8790
DATABASE_URL=postgres://litty:litty@localhost:54330/litty?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
WEB_ORIGIN=http://localhost:5190
# SECRET_KEY：加密「後台設定頁填的憑證」與「IG 連線的 access token」（存 DB 用 AES-256-GCM）的金鑰，任意長字串。
# 沒設時暫由 JWT_SECRET 衍生（MVP 兜底，啟動會印警告）；正式環境請設獨立值，且設定後不要再換，
# 換了（或兜底時換 JWT_SECRET）已存的後台憑證會解不開（退回下面的 .env 值），已連結的 IG 帳號也要重新連結。
SECRET_KEY=
# Instagram（DEV_SIMULATOR=1 時不打真 IG，開啟 /api/dev/simulate）
DEV_SIMULATOR=1
# 下列 IG_*／ANTHROPIC_API_KEY／AI_* 都是「兜底」：設定頁（憑證）填過的值存在 DB，優先於 .env，存檔立即生效；
# 設定頁「清除後台設定」後才會回到這裡的值。
# IG 連結走 Instagram API with Unified Login（Facebook 登入的「配置」）：
# IG_APP_ID／IG_APP_SECRET：Meta App ID／App Secret（應用程式設定 → 基本資料）；App Secret 也用來驗 webhook 簽章
# IG_CONFIG_ID：Facebook 登入 →「配置」的配置 ID（配置裡勾 instagram_basic、instagram_manage_messages、
#   instagram_content_publish、instagram_manage_insights；token 壽命也在配置裡設，預設永不過期）
# OAuth redirect URI＝WEB_ORIGIN + /api/ig/oauth/callback（Meta 後台要登記同一個網址，必須 HTTPS）
IG_APP_ID=
IG_APP_SECRET=
IG_CONFIG_ID=
IG_VERIFY_TOKEN=
# 兜底用：帳號沒有掛在任何連線（沒連結）時才用
IG_ACCESS_TOKEN=
# 系統用戶 token 只能打 graph.facebook.com（graph.instagram.com 不行）
IG_API_BASE=https://graph.facebook.com/v27.0
# AI（Claude API；未設 key 時只跑關鍵字規則）
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# 貼文排程
MEDIA_DIR=./data/media
PUBLIC_BASE_URL=http://localhost:8790
